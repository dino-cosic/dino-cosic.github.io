---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.homeLastmod }}</lastmod>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
    {%- if collections.posts.length %}
    <lastmod>{{ (collections.posts[0].data.updated or collections.posts[0].date) | isoDate }}</lastmod>
    {%- endif %}
  </url>
  {%- for post in collections.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ (post.data.updated or post.date) | isoDate }}</lastmod>
  </url>
  {%- endfor %}
  {%- for tag in collections.blogTags %}
  <url>
    <loc>{{ site.url }}/blog/tags/{{ tag.slug }}/</loc>
  </url>
  {%- endfor %}
</urlset>
